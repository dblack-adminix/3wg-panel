# 3WG Panel production environment example
# Copy to .env and edit before running the container.

PANEL_USER=admin
PANEL_PASSWORD=change-me
SESSION_SECRET=change-me-64-random-hex

# Public hostname used in generated client configs.
ENDPOINT_HOST=vpn.example.com

# WireGuard container managed by Amnezia or your own deployment.
WG_CONTAINER=amnezia-wireguard
WG_INTERFACE=wg0
WG_PORT=51820
WG_CONFIG_PATH=/opt/amnezia/wireguard/wg0.conf
WG_NETWORK=10.8.1.0/24

# AmneziaWG container.
AWG_CONTAINER=amnezia-awg2
AWG_INTERFACE=awg0
AWG_PORT=42300
AWG_CONFIG_PATH=/opt/amnezia/awg/awg0.conf
AWG_NETWORK=10.8.1.0/24

DNS_SERVERS=1.1.1.1, 1.0.0.1
HIDE_EXISTING_PEERS=1
