# Пример production-настроек 3WG Panel
# Скопируйте файл в .env и измените значения перед запуском контейнера.

PANEL_USER=admin
PANEL_PASSWORD=change-me
PANEL_CONTAINER=3wg-panel
SESSION_SECRET=change-me-64-random-hex

# Публичный web-хост панели.
PANEL_HOST=panel.example.com

# VPN endpoint, который будет записан в клиентские конфиги и QR.
# Если отдельного сменяемого IP/домена нет, оставьте таким же как PANEL_HOST.
ENDPOINT_HOST=vpn.example.com
VPN_ENDPOINT_HOST=vpn.example.com

# Опционально: IP для будущей managed SNAT/policy routing схемы.
# Сейчас это информационная настройка, сам egress firewall на хосте не меняется.
VPN_EGRESS_IP=

# WireGuard-контейнер, созданный Amnezia или вашей собственной установкой.
WG_CONTAINER=amnezia-wireguard
WG_INTERFACE=wg0
WG_PORT=51820
WG_CONFIG_PATH=/opt/amnezia/wireguard/wg0.conf
WG_NETWORK=10.8.1.0/24

# AmneziaWG-контейнер.
AWG_CONTAINER=amnezia-awg2
AWG_INTERFACE=awg0
AWG_PORT=42300
AWG_CONFIG_PATH=/opt/amnezia/awg/awg0.conf
AWG_NETWORK=10.8.1.0/24

DNS_SERVERS=1.1.1.1, 1.0.0.1
HIDE_EXISTING_PEERS=1

# Prometheus metrics. Включайте только за firewall/private VPN или с токеном.
METRICS_ENABLED=0
METRICS_REQUIRE_TOKEN=1
METRICS_TOKEN=change-me-random-token

# Telegram notifications. Можно оставить пустым и настроить в web UI: /monitoring.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# UI Update Center. Команды обновления выполняет host-side systemd runner.
UPDATE_RUNNER_ENABLED=1
UPDATE_RUNNER_SOCKET=/app/run/update-runner.sock
